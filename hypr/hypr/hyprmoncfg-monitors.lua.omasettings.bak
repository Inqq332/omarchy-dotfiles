-- Generated by hyprmoncfg (Модифицировано вручную)

-- 1. Левый TMN монитор
hl.monitor({
  output = "desc:TMN SUN-M24BA100 000000000000",
  mode = "1920x1080@74.97",
  position = "0x110",
  scale = 1,
})

-- 2. Правый Xiaomi (Главный)
hl.monitor({
  output = "desc:Xiaomi Corporation Mi monitor 7094010016104",
  mode = "3440x1440@165.00",
  position = "1920x0",
  scale = 1.25,
})

-- 3. Телевизор Philips (Вместо disabled = true мы пишем auto-placement)
-- Это заставит систему включать его АВТОМАТИЧЕСКИ, когда в него воткнут провод HDMI,
-- и не ломать систему, когда провода нет.
hl.monitor({
  output = "desc:Philips Consumer Electronics Company PHILIPS FTV 0x01010101",
  mode = "preferred",
  position = "auto-right", -- Автоматически встанет справа от Xiaomi, если включен
  scale = 1,
})

-- Правила рабочих столов (Воркспейсов)
hl.workspace_rule({ workspace = "1", monitor = "desc:Xiaomi Corporation Mi monitor 7094010016104", default = true, persistent = true })
hl.workspace_rule({ workspace = "2", monitor = "desc:TMN SUN-M24BA100 000000000000", default = true, persistent = true })

